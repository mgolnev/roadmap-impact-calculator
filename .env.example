# PostgreSQL (общий roadmap)
# Для Amvera используйте внутренний rw-host кластера. DATABASE_URL доступен только серверу.
DATABASE_URL=postgresql://roadmap_user:change-me@amvera-username-cnpg-roadmap-rw:5432/roadmap

# Внутри сети Amvera SSL не используется. Для внешнего подключения задайте true.
DATABASE_SSL=false

# Необязательно: размер пула соединений и локальный порт.
PGPOOL_MAX=5
PORT=3000

# Вместо DATABASE_URL библиотека pg также поддерживает стандартные переменные:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=roadmap
# PGUSER=roadmap_user
# PGPASSWORD=change-me
